string Name;
int32 Reads;

Init(string name) {
  Name = name;
}

func Maybe(): NullErgonomics? {
  Reads = Reads + 1;
  return self;
}

static func Fallback(): string {
  println("fallback");
  return "Unknown";
}

static func Main() {
  NullErgonomics? user = NullErgonomics("Cloth");
  string? name = user?.Name;
  string display = user?.Name ?? Fallback();
  if (user) {
    println(display);
  }

  NullErgonomics present = user!;
  println(present.Name);

  user = null;
  println(user?.Name ?? Fallback());
  if (!user) {
    println("missing");
  }

  NullErgonomics source = NullErgonomics("once");
  println(source.Maybe()?.Name ?? Fallback());
  println(source.Reads);
}
