GcStress? Next;
int32 Value;

Init(int32 value, GcStress? next) {
  Value = value;
  Next = next;
}

static func Main() {
  GcStress? head = null;
  int32 value = 0;
  while (value < 5000) {
    head = GcStress(value, head);
    value = value + 1;
  }

  int32 count = 0;
  while (head) {
    count = count + 1;
    head = head.Next;
  }
  println(count);
}
