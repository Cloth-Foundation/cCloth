static func Main() {
  string empty = "";
  string greeting = "Hello, " + "Cloth";
  string unicode = "é🙂";
  string withNull = "A\0B";

  println(greeting);
  println(greeting == "Hello, Cloth");
  println(greeting != "other");
  println(greeting::length);
  println(greeting::byteLength);
  println(empty::isEmpty);
  println(unicode::length);
  println(unicode::byteLength);
  println(withNull::length);
  println(withNull::byteLength);
}
