module cloth;

import std.io;

public class NumberFunctions(i32? number): Number(number) is Serializable {
    private const i32? myInt { public get; };
    private const unsigned? myUnsigned { public get; };

    #Prototype
    #Trait Deprecated(since="1.0.0", remove="1.1.0", message="Use toUnsignedChecked() instead")
    public func intToUnsigned() :> unsigned maybe NegativeNumberError, NullValueError;

    public NumberFunctions maybe NegativeNumberError, NullValueError {
        this.myInt = number;
        this.myUnsigned = intToUnsigned();
    }

    public func convertIntToFloat() :> float maybe NullValueError {
        const i32 value = getMyInt() | throw NullValueError("myInt is null");
        return value as float;
    }

    public func intToUnsigned() :> unsigned maybe NegativeNumberError, NullValueError {
        const i32 value = getMyInt() | throw NullValueError("myInt is null");
        return (value as? unsigned) | throw NegativeNumberError("Negative number");
    }

    #Override
    public func Number::subtract(int x) :> int {
        return this.number - x | NaN;
    }
}