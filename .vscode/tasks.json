{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: configure",
            "type": "process",
            "command": "cmake",
            "args": [
                "--preset",
                "dev"
            ],
            "problemMatcher": []
        },
        {
            "label": "CMake: build",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "dev"
            ],
            "dependsOn": "CMake: configure",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "CMake: build and run compiler",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "dev",
                "--target",
                "run_compiler"
            ],
            "dependsOn": "CMake: configure",
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "CMake: test",
            "type": "process",
            "command": "ctest",
            "args": [
                "--preset",
                "dev"
            ],
            "dependsOn": "CMake: build",
            "problemMatcher": []
        },
        {
            "label": "CMake: check format",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "dev",
                "--target",
                "check_format"
            ],
            "dependsOn": "CMake: configure",
            "problemMatcher": []
        }
    ]
}
